{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TLabel Annotation Format",
  "version": "0.8.0",
  "description": "Schema for TLabel cross-sensor tactile annotation files — v0.8 aligns with code: tlabel_v2 dict, sensor_profile, feature_metadata, episode labels",
  "type": "object",
  "required": ["schema_version", "format", "sensor", "capabilities", "frames"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$",
      "description": "TLabel schema version (semver)"
    },
    "format": {
      "type": "string",
      "const": "tlabel_v2",
      "description": "Format identifier, always 'tlabel_v2'"
    },
    "tlabel_dimensions": {
      "type": "integer",
      "const": 22,
      "description": "Number of annotation dimensions"
    },
    "feature_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ordered list of the 22 dimension keys in tlabel_v2"
    },
    "feature_metadata": {
      "type": "object",
      "description": "Per-feature semantic metadata (computation, semantics, units, calibration deps)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "feature_id": { "type": "integer" },
          "category": { "type": "string", "enum": ["deformation", "gradient", "force_semantic", "temporal"] },
          "computation": { "type": "string" },
          "physical_semantics": { "type": "string" },
          "si_unit": { "type": ["string", "null"] },
          "raw_unit": { "type": "string" },
          "force_correlation": { "type": "string", "enum": ["direct", "high", "moderate", "low", "indirect"] },
          "requires_calibration": { "type": "boolean" },
          "calibration_depends_on": { "type": "array", "items": { "type": "string" } },
          "deprecated": { "type": "boolean" },
          "deprecated_since": { "type": "string" },
          "replacement": { "type": "string" }
        },
        "required": ["feature_id", "category", "computation", "physical_semantics", "raw_unit", "force_correlation", "requires_calibration"]
      }
    },
    "sensor": {
      "type": "object",
      "required": ["sensor_name", "sensor_type", "adapter_name", "adapter_version"],
      "properties": {
        "sensor_name": { "type": "string", "description": "Sensor product name" },
        "sensor_type": { "type": "string", "enum": ["vision_based", "distributed_array", "hybrid"], "description": "Sensor category" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "resolution": { "type": "string" },
        "frame_rate": { "type": "number", "minimum": 1 },
        "adapter_name": { "type": "string", "description": "TLabel adapter identifier" },
        "adapter_version": { "type": "string", "description": "Adapter version (semver)" }
      }
    },
    "sensor_id": {
      "type": ["string", "null"],
      "description": "Instance identifier (e.g. 'left_gripper', 'finger_2')"
    },
    "sensor_profile": {
      "type": ["object", "null"],
      "description": "v0.7+: Sensor physical properties — elastomer, optical, calibration. All fields optional.",
      "properties": {
        "sensor_type": { "type": ["string", "null"] },
        "manufacturer": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "elastomer": {
          "type": ["object", "null"],
          "properties": {
            "material": { "type": ["string", "null"] },
            "modulus_pa": { "type": ["number", "null"], "minimum": 0 },
            "thickness_mm": { "type": ["number", "null"], "minimum": 0 },
            "friction_coefficient": { "type": ["number", "null"], "minimum": 0 },
            "source": { "type": ["string", "null"] }
          }
        },
        "optical": {
          "type": ["object", "null"],
          "properties": {
            "light_source": { "type": ["string", "null"] },
            "led_wavelength_nm": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "calibration": {
          "type": ["object", "null"],
          "properties": {
            "method": { "type": ["string", "null"], "enum": ["literature", "self_calibrated", "manufacturer_spec", "none", null] },
            "reference_doi": { "type": ["string", "null"] },
            "pixel_to_force_coefficient": { "type": ["number", "null"], "minimum": 0 },
            "pixel_to_force_unit": { "type": ["string", "null"], "default": "N/pixel" }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "calibration": {
      "type": ["object", "null"],
      "description": "Legacy calibration params (prefer sensor_profile.calibration)"
    },
    "episode": {
      "type": "object",
      "required": ["episode_id", "task"],
      "properties": {
        "episode_id": { "type": "string" },
        "task": { "type": "string" },
        "object": { "type": ["string", "null"] },
        "num_frames": { "type": "integer" },
        "duration_s": { "type": "number" },
        "stats": {
          "type": "object",
          "properties": {
            "contact_frames": { "type": "integer" },
            "contact_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "slip_frames": { "type": "integer" },
            "slip_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "modified_frames": { "type": "integer" }
          }
        },
        "episode_label": {
          "type": ["object", "null"],
          "properties": {
            "outcome": { "type": "string", "enum": ["success", "partial", "failure", "inconclusive"] },
            "manipulation_type": { "type": "string", "enum": ["grasp", "pinch", "poke", "slide", "push", "pull", "tap", "lift", "place", "other"] },
            "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
            "notes": { "type": "string" },
            "annotator": { "type": "string" },
            "verified": { "type": "boolean" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["contact"],
      "properties": {
        "contact": { "type": "boolean" },
        "contact_region": { "type": "boolean" },
        "force_magnitude": { "type": "boolean" },
        "deformation_magnitude_peak": { "type": "boolean" },
        "force_direction": { "type": "boolean" },
        "slip_event": { "type": "boolean" },
        "slip_direction": { "type": "boolean" },
        "manipulation_phase": { "type": "boolean" },
        "texture": { "type": "boolean" },
        "whole_hand_coordination": { "type": "boolean" },
        "object_deformation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame_idx", "timestamp_s", "tlabel_v2", "manipulation_phase"],
        "properties": {
          "frame_idx": { "type": "integer" },
          "timestamp_s": { "type": "number" },
          "is_first": { "type": "boolean" },
          "is_last": { "type": "boolean" },
          "tlabel_v2": {
            "type": "object",
            "description": "The 22-dimension annotation values for this frame",
            "properties": {
              "contact": { "type": "number", "minimum": 0, "maximum": 1 },
              "deformation_magnitude": { "type": "number", "minimum": 0 },
              "force_magnitude": { "type": "number", "minimum": 0, "description": "DEPRECATED: alias of deformation_magnitude" },
              "force_peak": { "type": "number", "minimum": 0 },
              "force_direction": { "type": "number" },
              "slip_entropy": { "type": "number", "minimum": 0 },
              "slip_event": { "type": "number", "minimum": 0, "maximum": 1 },
              "texture_energy": { "type": "number", "minimum": 0 },
              "edge_density": { "type": "number", "minimum": 0 },
              "contact_area": { "type": "number", "minimum": 0 },
              "centroid_x": { "type": "number" },
              "normal_field_magnitude": { "type": "number", "minimum": 0 },
              "normal_field_variance": { "type": "number", "minimum": 0 },
              "shear_field_magnitude": { "type": "number", "minimum": 0 },
              "shear_field_direction": { "type": "number" },
              "delta_force_normal": { "type": "number" },
              "delta_force_shear": { "type": "number" },
              "friction_cone_ratio": { "type": "number", "minimum": 0 },
              "optical_flow_magnitude": { "type": "number", "minimum": 0 },
              "optical_flow_direction": { "type": "number" },
              "temporal_deformation_rate": { "type": "number" },
              "contact_transition": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "manipulation_phase": {
            "type": "string",
            "enum": ["idle", "initial_contact", "stable_contact", "slip", "release", "re_contact", "approach", "retract", "grasp", "transport", "hold"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sensor_specific": { "type": "object" },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "old_value", "new_value"],
              "properties": {
                "field": { "type": "string" },
                "old_value": {},
                "new_value": {},
                "cascade": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": { "type": "string" },
                      "old_value": {},
                      "new_value": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
