{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TLabel Schema V2.1",
  "version": "2.1.0",
  "description": "TLabel Schema V2.1 — 14维结构化触觉语义标注规范，支持 Compliance Level (L1-L4) 分层",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "sensor",
    "capabilities",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "TLabel schema version (semver)",
      "examples": [
        "2.1.0"
      ]
    },
    "format": {
      "type": "string",
      "const": "tlabel_schema_v2",
      "description": "Format identifier for Schema V2.1"
    },
    "schema_version_v2": {
      "type": "string",
      "const": "2.1",
      "description": "Schema V2 major.minor version"
    },
    "tlabel_dimensions": {
      "type": "integer",
      "const": 14,
      "description": "Number of Schema V2.1 semantic dimensions"
    },
    "feature_names_v2": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of the 14 Schema V2.1 dimension keys",
      "minItems": 14,
      "maxItems": 14
    },
    "sensor": {
      "type": "object",
      "required": [
        "sensor_name",
        "sensor_type",
        "adapter_name",
        "adapter_version"
      ],
      "properties": {
        "sensor_name": {
          "type": "string",
          "description": "Sensor product name"
        },
        "sensor_type": {
          "type": "string",
          "enum": [
            "vision_based",
            "distributed_array",
            "hybrid"
          ],
          "description": "Sensor category"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "frame_rate": {
          "type": "number",
          "minimum": 1
        },
        "adapter_name": {
          "type": "string",
          "description": "TLabel adapter identifier"
        },
        "adapter_version": {
          "type": "string",
          "description": "Adapter version (semver)"
        },
        "compliance_level": {
          "type": "string",
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "description": "Default compliance level for this sensor adapter"
        }
      }
    },
    "sensor_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Instance identifier (e.g. 'left_gripper', 'finger_2')"
    },
    "sensor_profile": {
      "type": [
        "object",
        "null"
      ],
      "description": "Sensor physical properties — elastomer, optical, calibration",
      "properties": {
        "sensor_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "elastomer": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "material": {
              "type": [
                "string",
                "null"
              ]
            },
            "modulus_pa": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "thickness_mm": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "friction_coefficient": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "optical": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "light_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "led_wavelength_nm": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "calibration": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference_doi": {
              "type": [
                "string",
                "null"
              ]
            },
            "pixel_to_force_coefficient": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "pixel_to_force_unit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "calibration": {
      "type": [
        "object",
        "null"
      ],
      "description": "Legacy calibration params (prefer sensor_profile.calibration)"
    },
    "episode": {
      "type": "object",
      "required": [
        "episode_id",
        "task"
      ],
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "object": {
          "type": [
            "string",
            "null"
          ]
        },
        "num_frames": {
          "type": "integer"
        },
        "duration_s": {
          "type": "number"
        },
        "stats": {
          "type": "object",
          "properties": {
            "contact_frames": {
              "type": "integer"
            },
            "contact_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "slip_frames": {
              "type": "integer"
            },
            "slip_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "modified_frames": {
              "type": "integer"
            }
          }
        },
        "episode_label": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "success",
                "partial",
                "failure",
                "inconclusive"
              ]
            },
            "manipulation_type": {
              "type": "string",
              "enum": [
                "grasp",
                "pinch",
                "poke",
                "slide",
                "push",
                "pull",
                "tap",
                "lift",
                "place",
                "other"
              ]
            },
            "difficulty": {
              "type": "string",
              "enum": [
                "easy",
                "medium",
                "hard"
              ]
            },
            "notes": {
              "type": "string"
            },
            "annotator": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Schema V2.1 per-field capability flags",
      "properties": {
        "contact": {
          "type": "boolean"
        },
        "contact_centroid": {
          "type": "boolean"
        },
        "contact_region": {
          "type": "boolean"
        },
        "force_magnitude": {
          "type": "boolean"
        },
        "force_vector": {
          "type": "boolean"
        },
        "torque_vector": {
          "type": "boolean"
        },
        "slip_event": {
          "type": "boolean"
        },
        "slip_velocity": {
          "type": "boolean"
        },
        "manipulation_phase": {
          "type": "boolean"
        },
        "texture_class": {
          "type": "boolean"
        },
        "object_deformation": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "confidence": {
          "type": "boolean"
        },
        "compliance_level": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "frame_idx",
          "timestamp_s",
          "schema_v2",
          "confidence"
        ],
        "properties": {
          "frame_idx": {
            "type": "integer"
          },
          "timestamp_s": {
            "type": "number"
          },
          "is_first": {
            "type": "boolean"
          },
          "is_last": {
            "type": "boolean"
          },
          "schema_v2": {
            "type": "object",
            "description": "TLabel Schema V2.1 — 14维结构化语义标注",
            "required": [
              "contact",
              "slip_event",
              "confidence",
              "compliance_level"
            ],
            "properties": {
              "contact": {
                "type": "boolean",
                "description": "接触状态",
                "required": true
              },
              "contact_centroid": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "接触中心坐标 [x, y]，单位：传感器像素坐标或mm。contact=true 时必填",
                "required_when": "contact=true"
              },
              "contact_region": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "palmar",
                  "digital",
                  "lateral",
                  "proximal",
                  "distal",
                  "dorsal",
                  "other",
                  null
                ],
                "description": "粗粒度接触区域枚举"
              },
              "force_magnitude": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "unit": "N",
                "description": "法向接触力标量。compliance_level >= L2 时约定必填",
                "required_when": "compliance_level >= L2"
              },
              "force_vector": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "unit": "N",
                "description": "三维接触力 [Fx, Fy, Fz]。compliance_level >= L3 时必填",
                "required_when": "compliance_level >= L3"
              },
              "torque_vector": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "unit": "N·m",
                "description": "三维力矩 [Mx, My, Mz]"
              },
              "slip_event": {
                "type": "boolean",
                "description": "滑动检测",
                "required": true
              },
              "slip_velocity": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "unit": "mm/s",
                "description": "滑动速度向量 [vx, vy]。slip_event=true 时建议填写"
              },
              "manipulation_phase": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "pre_contact",
                  "approach",
                  "grasp",
                  "lift",
                  "hold",
                  "place",
                  null
                ],
                "description": "操作阶段枚举"
              },
              "texture_class": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "smooth",
                  "rough",
                  "granular",
                  "fibrous",
                  "sticky",
                  "slippery",
                  null
                ],
                "description": "纹理类别枚举"
              },
              "object_deformation": {
                "type": [
                  "number",
                  "null"
                ],
                "unit": "mm or ratio",
                "description": "物体形变量"
              },
              "temperature": {
                "type": [
                  "number",
                  "null"
                ],
                "unit": "°C",
                "description": "接触面温度"
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0,
                "description": "标注置信度",
                "required": true
              },
              "compliance_level": {
                "type": "string",
                "enum": [
                  "L1",
                  "L2",
                  "L3",
                  "L4"
                ],
                "description": "合规等级。L1=基础触觉, L2=力感知, L3=完整力向量, L4=完整语义",
                "required": true
              }
            },
            "additionalProperties": false
          },
          "tlabel_v2": {
            "type": [
              "object",
              "null"
            ],
            "description": "DEPRECATED since v2.1: 旧版22维 flat dict，保留向后兼容"
          },
          "manipulation_phase": {
            "type": "string",
            "description": "DEPRECATED: use schema_v2.manipulation_phase"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Frame-level confidence (also in schema_v2)"
          },
          "sensor_specific": {
            "type": "object"
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "old_value",
                "new_value"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "old_value": {},
                "new_value": {},
                "cascade": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "old_value": {},
                      "new_value": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}